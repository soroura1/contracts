{
  "name": "@citadel/contracts",
  "version": "0.7.0",
  "description": "The interface between Citadel services. OpenAPI, JSON Schemas, the refusal registry, the conformance suite. Nothing runs here.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    "./schemas/*": "./schemas/*",
    "./openapi/*": "./openapi/*",
    "./refusals": "./refusals/registry.json",
    "./types": "./types/index.d.ts",
    "./conformance": "./conformance/src/index.js",
    "./rules": "./rules/lifecycle.js"
  },
  "files": [
    "openapi",
    "schemas",
    "refusals",
    "types",
    "conformance",
    "VERSIONING.md",
    "rules"
  ],
  "scripts": {
    "check": "./check-repo.sh && node conformance/src/validate-artifacts.js",
    "types": "node scripts/generate-types.js",
    "conformance": "node conformance/src/self.js",
    "test": "node --test rules/*.test.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
